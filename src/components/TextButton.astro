---
// Mirrors components/Button/textButton.jsx + styles/button.scss .textButton
// Transparent text-style link: bold uppercase Poppins, colored by `type`.
interface Props {
  type?: string; // e.g. "primary" → text-primary color
  href?: string;
  label?: string;
}
const { type = "primary", href, label } = Astro.props;

const colors: Record<string, string> = {
  primary: "#47789e",
  light: "#fefefe",
  dark: "#212b40",
};
const color = colors[type] ?? colors.primary;
---

<a
  href={href}
  role="button"
  class="textButton font-heading font-bold uppercase border-0 cursor-pointer mr-8 inline-block"
  style={`color:${color}`}
>
  <span class="align-middle pr-1">{label}</span>
</a>
